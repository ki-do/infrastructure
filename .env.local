STACK_HOSTNAME=localhost
ACME_EMAIL=dev@localhost
TRAEFIK_DOCKER_NETWORK=things_network

# Auth settings for localhost
INSECURE_COOKIE=true
COOKIE_SECURE=false
AUTH_HOST=auth.localhost

# Grafana
GRAFANA_DOMAIN=grafana.localhost
GRAFANA_ROOT_URL=https://grafana.localhost

# Service Ports
WEB_PORT_IN=80
WEB_PORT_OUT=80
TRAEFIK_DASHBOARD_PORT_IN=8080
TRAEFIK_DASHBOARD_PORT_OUT=8080
FORWARD_AUTH_PORT=4181
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
CADVISOR_PORT=8080
JAEGER_PORT=16686
JAEGER_COLLECTOR_PORT=14268
JAEGER_AGENT_PORT=6831
JAEGER_ZIPKIN_PORT=9411
LOKI_PORT=3100
LOKI_HOSTNAME=http://loki

# Modbus/CoAP/MQTT Ports
MODBUS_ELEVATOR_PORT_IN=8088
MODBUS_ELEVATOR_PORT_OUT=8088
COAP_SIMPLE_PORT_IN=5683
COAP_SIMPLE_PORT_OUT=5683
COAP_NEGOTIATION_PORT_IN=5684
COAP_NEGOTIATION_PORT_OUT=5684
SMART_HOME_SMART_CLOCK_PORT_IN=5685
SMART_HOME_SMART_CLOCK_PORT_OUT=5685
MOSQUITTO_PORT_IN=1883

# MQTT Broker
BROKER_URI=mqtt://mosquitto:1883

# Jaeger
JAEGER_ENDPOINT=http://jaeger:14268/api/traces

CONFIG_FILEPATH=./conf